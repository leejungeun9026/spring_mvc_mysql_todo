<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jungeun.todoservice.mapper.TodoMapper">
    <select id="getTodoList" resultType="com.jungeun.todoservice.domain.TodoVO">
        select * from tbltodo order by tno desc
    </select>

    <sql id="search">
        <where>
            <if test="types != null and types.length > 0">
                <foreach collection="types" item="type" open="(" close=") " separator="OR">
                    <if test="type=='t'.toString()">
                        title like concat('%', #{keyword}, '%')
                    </if>
                    <if test="type=='w'.toString()">
                        writer like concat('%', #{keyword}, '%')
                    </if>
                    <if test="type=='c'.toString()">
                        content like concat('%', #{keyword}, '%')
                    </if>
                </foreach>
            </if>
            <if test="finished">
                <trim prefix="and">
                    finished=1
                </trim>
            </if>
            <if test="from !=null and to != null">
                <trim prefix="and">
                    dueDate between #{from} and #{to}
                </trim>
            </if>
        </where>
    </sql>

    <select id="selectTodoList" resultType="com.jungeun.todoservice.domain.TodoVO">
        select * from tbltodo
        <include refid="search"></include>
        order by tno desc limit #{skip}, #{size}
    </select>
    <select id="getCount" resultType="int">
        select count(tno) from tbltodo
        <include refid="search"></include>
    </select>
    <select id="selectTodoOne" resultType="com.jungeun.todoservice.domain.TodoVO">
        select * from tbltodo where tno=#{tno}
    </select>
    <insert id="insertTodo">
        insert into tbltodo(title, content, duedate, writer) values(#{title}, #{content}, #{duedate}, #{writer})
    </insert>
    <update id="updateTodo">
        update tbltodo set title=#{title}, content=#{content}, duedate=#{duedate}, finished=#{finished} where tno=#{tno}
    </update>
    <delete id="deleteTodo">
        delete from tbltodo where tno=#{tno}
    </delete>
</mapper>